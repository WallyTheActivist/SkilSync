DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN="7d"
CLIENT_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
PORT=5000
NODE_ENV="development"
# In production, SMTP_SECURE=false requires STARTTLS; true uses implicit TLS.
# SMTP certificates are always validated.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SkillSync <no-reply@example.com>"
EMAIL_VERIFICATION_TTL_HOURS=24
SKILLSYNC_ALLOW_DEMO_SEED="false"
